# Clone o arquivo no seu ambiente local, 
# preencha com os valores corretos de ambiente e renomeie para .env
# Comando: cp .env.example .env

# Porta de execução da API
PORT=3000

# Conexão com o Postgres.
#Atenção: Use apenas uma das conexões abaixo, comente a que não for utilizada.
#Não rode migrations em produção, apenas no local. Conexão com Neon apenas quando necessário.

# # Neon: pegue os valores em Dashboard > Connect > "Parameters only".
# DB_HOST=
# DB_PORT=
# DB_USER=
# DB_PASSWORD=
# DB_NAME=

# Postgres local: DB_HOST=localhost e DB_SSL=false.
DB_HOST=localhost
DB_PORT=5433
DB_USER=hubee
DB_PASSWORD=hubee
DB_NAME=hubee

# true para Neon (exige TLS), false para Postgres local
DB_SSL=false

JWT_SECRET=troque-por-um-segredo-forte

CORS_ORIGINS=http://localhost:3001

# Vercel Blob: guarda as capas de evento (PATCH /events/:id/photo).
# Pegue em Vercel > Storage > seu Blob store > .env.local.
# Sem ele a API sobe normalmente, mas o envio de capa responde 503.
BLOB_READ_WRITE_TOKEN=

# Claude (Anthropic): geração de rascunho de evento com IA.
# Pegue a chave em platform.claude.com > API Keys.
# Sem ela a API sobe normalmente, mas as rotas de IA respondem 503.
ANTHROPIC_API_KEY=
# Modelo usado nas chamadas (padrão: claude-opus-5-5)
ANTHROPIC_MODEL=claude-opus-5-5
# Tempo máximo de espera por resposta da IA, em milissegundos
AI_TIMEOUT_MS=30000
